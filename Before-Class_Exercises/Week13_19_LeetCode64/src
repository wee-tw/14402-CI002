#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    int minPathSum(vector<vector<int>>& grid) {
        int m = grid.size(), n = grid[0].size();
        for (int i = 0; i < m; ++i) {
            for (int j = 0; j < n; ++j) {
                if (i == 0 && j == 0) continue;
                int from_up = i > 0 ? grid[i - 1][j] : INT_MAX;
                int from_left = j > 0 ? grid[i][j - 1] : INT_MAX;
                grid[i][j] += min(from_up, from_left);
            }
        }
        return grid[m - 1][n - 1];
    }
};
