#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    string decodeString(string s) {
        stack<pair<string, int>> st;
        string cur;
        int num = 0;
        for (char ch : s) {
            if (isdigit((unsigned char)ch)) {
                num = num * 10 + (ch - '0');
            } else if (ch == '[') {
                st.push({cur, num});
                cur.clear();
                num = 0;
            } else if (ch == ']') {
                string prev = st.top().first;
                int repeat = st.top().second;
                st.pop();
                string expanded;
                while (repeat--) expanded += cur;
                cur = prev + expanded;
            } else {
                cur.push_back(ch);
            }
        }
        return cur;
    }
};
