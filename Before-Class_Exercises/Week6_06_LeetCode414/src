#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    int thirdMax(vector<int>& nums) {
        set<int> top;
        for (int x : nums) {
            top.insert(x);
            if (top.size() > 3) top.erase(top.begin());
        }
        if (top.size() == 3) return *top.begin();
        return *top.rbegin();
    }
};
