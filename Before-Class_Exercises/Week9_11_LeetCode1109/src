#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    vector<int> corpFlightBookings(vector<vector<int>>& bookings, int n) {
        vector<int> diff(n + 1, 0);
        for (const vector<int>& b : bookings) {
            int l = b[0] - 1, r = b[1] - 1, seats = b[2];
            diff[l] += seats;
            if (r + 1 < n) diff[r + 1] -= seats;
        }
        vector<int> ans(n);
        int cur = 0;
        for (int i = 0; i < n; ++i) {
            cur += diff[i];
            ans[i] = cur;
        }
        return ans;
    }
};
