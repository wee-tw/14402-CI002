#include <iostream>
#include <vector>
#include <cmath>
#include <algorithm>
#include <map>
#include <string>
#include <cstring>
#include <iomanip>
#include <sstream>
using namespace std;

int main() {

	string line;
	if (!getline(cin, line)) return 0;
	int c = stoi(line);

	cout << fixed << setprecision(4);

	getline(cin, line);

	for (int t = 1; t <= c; t++) {

		map<string, int> MAP;

		int total = 0;
		while (true) {
			if (!getline(cin, line)) break;
			if (line.empty()) break;
			MAP[line]++;
			total++;
		}

		for (auto it = MAP.begin(); it != MAP.end(); it++) {
			double result = 100 * (double)it->second / (double)total;
			cout << it->first << " " << result << endl;
		}

		if (t != c) cout << endl;
	}
	return 0;
}