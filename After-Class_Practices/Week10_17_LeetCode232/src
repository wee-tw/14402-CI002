#include <bits/stdc++.h>
using namespace std;

class MyQueue {
private:
    stack<int> in, out;

    void moveIfNeeded() {
        if (!out.empty()) return;
        while (!in.empty()) {
            out.push(in.top());
            in.pop();
        }
    }

public:
    void push(int x) {
        in.push(x);
    }

    int pop() {
        moveIfNeeded();
        int value = out.top();
        out.pop();
        return value;
    }

    int peek() {
        moveIfNeeded();
        return out.top();
    }

    bool empty() {
        return in.empty() && out.empty();
    }
};
