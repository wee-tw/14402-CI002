#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    vector<int> relativeSortArray(vector<int>& arr1, vector<int>& arr2) {
        vector<int> count(1001, 0), ans;
        for (int x : arr1) count[x]++;
        for (int x : arr2) {
            while (count[x]--) ans.push_back(x);
        }
        for (int x = 0; x <= 1000; ++x) {
            while (count[x]-- > 0) ans.push_back(x);
        }
        return ans;
    }
};
