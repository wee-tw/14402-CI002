#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    string convert(string s, int numRows) {
        if (numRows == 1 || (int)s.size() <= numRows) return s;
        vector<string> rows(numRows);
        int row = 0, dir = 1;
        for (char ch : s) {
            rows[row].push_back(ch);
            if (row == 0) dir = 1;
            else if (row == numRows - 1) dir = -1;
            row += dir;
        }
        string ans;
        for (const string& part : rows) ans += part;
        return ans;
    }
};
