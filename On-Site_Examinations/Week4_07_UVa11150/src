#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    while (cin >> n) {
        int ans = n, empty = n;
        while (empty >= 3) {
            ans += empty / 3;
            empty = empty / 3 + empty % 3;
        }
        if (empty == 2) ++ans;
        cout << ans << '\n';
    }
    return 0;
}
