#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    char ch;
    bool open = true;
    while (cin.get(ch)) {
        if (ch == '"') {
            cout << (open ? "``" : "''");
            open = !open;
        } else {
            cout << ch;
        }
    }
    return 0;
}
