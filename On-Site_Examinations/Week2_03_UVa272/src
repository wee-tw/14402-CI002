
#include <iostream>
#include <vector>
#include <cmath>
#include <algorithm>
#include <map>
#include <string>
#include <cstring>
using namespace std;


int main() {
	bool open = true;
	string line;

	while (getline(cin, line)) {

		for (int i = 0; i < line.length(); i++) {
			if (line[i] == '"') {
				if (open) {
					cout << "``";
					open = !open;
				}
				else {
					cout << "''";
					open = !open;
				}
			}
			else {
				cout << line[i];
			}
		}
		cout << endl;
	}



	return 0;
}