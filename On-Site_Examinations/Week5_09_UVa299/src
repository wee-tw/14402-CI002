#include <iostream>
#include <vector>
#include <cmath>
#include <algorithm>
#include <map>
#include <string>
#include <cstring>
#include <iomanip>
#include <sstream>
using namespace std;



int main() {

	int T;
	cin >> T;
	while (T--) {

		int n;
		cin >> n;
		vector<int> v(n);
		for (int i = 0; i < n; i++) {
			cin >> v[i];
		}

		int count = 0;
		for (int i = 0; i < n; i++) {
			for (int j = 0; j < n - i - 1; j++) {
				if (v[j] > v[j + 1]) {
					swap(v[j], v[j + 1]);
					count++;
				}
			}
		}


		cout << "Optimal train swapping takes " << count << " swaps.\n";
	}




	return 0;
}