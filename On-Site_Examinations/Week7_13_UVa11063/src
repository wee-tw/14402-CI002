#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, tc = 1;
    while (cin >> n) {
        vector<int> a(n);
        for (int &x : a) cin >> x;
        bool ok = n > 0 && a[0] >= 1;
        for (int i = 1; i < n; ++i) if (a[i] <= a[i - 1]) ok = false;
        set<int> sums;
        for (int i = 0; i < n && ok; ++i) {
            for (int j = i; j < n; ++j) {
                int s = a[i] + a[j];
                if (sums.count(s)) ok = false;
                sums.insert(s);
            }
        }
        cout << "Case #" << tc++ << ": It is " << (ok ? "" : "not ") << "a B2-Sequence.\n\n";
    }
    return 0;
}
