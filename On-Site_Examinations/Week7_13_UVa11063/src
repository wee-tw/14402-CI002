#include <iostream>
#include <vector>
#include <set>
using namespace std;

int main() {
    int n, caseNum = 1;
    
    while (cin >> n) {
        vector<int> b(n);
        bool valid = true;
        
        for (int i = 0; i < n; i++) {
            cin >> b[i];
            if (b[i] < 1) valid = false;
            if (i > 0 && b[i] <= b[i-1]) valid = false;
        }
        
        set<int> sums;
        for (int i = 0; i < n && valid; i++) {
            for (int j = i; j < n; j++) {
                int sum = b[i] + b[j];
                if (sums.count(sum)) {
                    valid = false;
                    break;
                }
                sums.insert(sum);
            }
        }
        
        cout << "Case #" << caseNum++ << ": It is ";
        if (!valid) cout << "not ";
        cout << "a B2-Sequence.\n" << endl;
    }
    
    return 0;
}