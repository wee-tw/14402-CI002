#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {

	int t;
	cin >> t;
	while (t--) {

		int n, a, b;
		cin >> n >> a >> b;

		int total = 1;
		for (int i = 0; i < n; i++) total *= 2;
		total -= 1;


		int MAX = max(a, b);

		int temp = MAX;

		int count = 0;
		int c = 1;

		while (true) {

			int father = 2 * temp;
			int mother = father + 1;

			if (father > total) break;

			temp = father;

			c *= 2;
			count += c;
		}

		cout << total - count << endl;
	}
	return 0;
}