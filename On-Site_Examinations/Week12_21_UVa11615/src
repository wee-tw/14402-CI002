#include <bits/stdc++.h>
using namespace std;

int level_of(long long node) {
    int level = 0;
    while (node > 1) {
        node >>= 1;
        ++level;
    }
    return level;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;
    while (T--) {
        long long n, a, b;
        cin >> n >> a >> b;
        int deepest = max(level_of(a), level_of(b));
        long long answer = (1LL << n) - (1LL << (n - deepest)) + 1;
        cout << answer << '\n';
    }
    return 0;
}
