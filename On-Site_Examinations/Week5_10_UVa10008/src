#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    cin >> n;
    string line;
    getline(cin, line);
    vector<int> cnt(26);
    while (n-- && getline(cin, line)) {
        for (char ch : line) {
            if (isalpha((unsigned char)ch)) cnt[toupper(ch) - 'A']++;
        }
    }
    vector<pair<char, int>> rows;
    for (int i = 0; i < 26; ++i) if (cnt[i]) rows.push_back({char('A' + i), cnt[i]});
    sort(rows.begin(), rows.end(), [](auto a, auto b) {
        if (a.second != b.second) return a.second > b.second;
        return a.first < b.first;
    });
    for (size_t i = 0; i < rows.size(); ++i) {
        cout << rows[i].first << ' ' << rows[i].second << '\n';
    }
    return 0;
}
