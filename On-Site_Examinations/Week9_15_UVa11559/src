#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, b, h, w;
    while (cin >> n >> b >> h >> w) {
        int best = INT_MAX;
        for (int i = 0; i < h; ++i) {
            int price;
            cin >> price;
            bool ok = false;
            for (int j = 0; j < w; ++j) {
                int beds;
                cin >> beds;
                if (beds >= n) ok = true;
            }
            if (ok && price * n <= b) best = min(best, price * n);
        }
        if (best == INT_MAX) cout << "stay home\n";
        else cout << best << '\n';
    }
    return 0;
}
