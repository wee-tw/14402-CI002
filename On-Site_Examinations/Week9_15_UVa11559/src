#include <iostream>
#include <climits>
using namespace std;

int main() {
    int N, B, H, W;
    while (cin >> N >> B >> H >> W) {
        int minCost = INT_MAX;
        
        for (int i = 0; i < H; i++) {
            int price;
            cin >> price;
            
            for (int j = 0; j < W; j++) {
                int beds;
                cin >> beds;
                if (beds >= N) {
                    int cost = N * price;
                    if (cost <= B && cost < minCost) {
                        minCost = cost;
                    }
                }
            }
        }
        
        if (minCost == INT_MAX) {
            cout << "stay home" << endl;
        } else {
            cout << minCost << endl;
        }
    }
    return 0;
}