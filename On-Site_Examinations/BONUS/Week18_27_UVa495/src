#include <bits/stdc++.h>
using namespace std;

string add_string(const string& a, const string& b) {
    string ans;
    int i = (int)a.size() - 1, j = (int)b.size() - 1, carry = 0;
    while (i >= 0 || j >= 0 || carry) {
        int sum = carry;
        if (i >= 0) sum += a[i--] - '0';
        if (j >= 0) sum += b[j--] - '0';
        ans.push_back(char('0' + sum % 10));
        carry = sum / 10;
    }
    reverse(ans.begin(), ans.end());
    return ans;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    vector<string> fib(5001);
    fib[0] = "0";
    fib[1] = "1";
    for (int i = 2; i <= 5000; ++i) fib[i] = add_string(fib[i - 1], fib[i - 2]);
    int n;
    while (cin >> n) {
        cout << "The Fibonacci number for " << n << " is " << fib[n] << '\n';
    }
    return 0;
}
