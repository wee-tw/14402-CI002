#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;
    for (int tc = 1; tc <= T; ++tc) {
        int n, d;
        cin >> n >> d;
        vector<int> pos = {0, 0};
        for (int i = 0; i < n; ++i) {
            string stone;
            cin >> stone;
            char type = stone[0];
            int x = stoi(stone.substr(2));
            pos.push_back(x);
            if (type == 'B') pos.push_back(x);
        }
        pos.push_back(d);
        pos.push_back(d);
        sort(pos.begin(), pos.end());
        int ans = 0;
        for (int i = 2; i < (int)pos.size(); ++i) ans = max(ans, pos[i] - pos[i - 2]);
        cout << "Case " << tc << ": " << ans << '\n';
    }
    return 0;
}
