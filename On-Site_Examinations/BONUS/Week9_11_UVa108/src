#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    cin >> n;
    vector<vector<int>> a(n, vector<int>(n));
    for (auto &row : a) for (int &x : row) cin >> x;
    int best = INT_MIN;
    for (int top = 0; top < n; ++top) {
        vector<int> col(n, 0);
        for (int bottom = top; bottom < n; ++bottom) {
            for (int c = 0; c < n; ++c) col[c] += a[bottom][c];
            int cur = 0;
            for (int x : col) {
                cur = max(x, cur + x);
                best = max(best, cur);
            }
        }
    }
    cout << best << '\n';
    return 0;
}
