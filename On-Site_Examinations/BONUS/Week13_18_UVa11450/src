#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;
    while (T--) {
        int money, garments;
        cin >> money >> garments;
        vector<vector<int>> price(garments);
        for (auto &row : price) {
            int k;
            cin >> k;
            row.resize(k);
            for (int &x : row) cin >> x;
        }
        vector<int> dp(money + 1, 0);
        dp[0] = 1;
        for (auto &row : price) {
            vector<int> next(money + 1, 0);
            for (int spent = 0; spent <= money; ++spent) if (dp[spent]) {
                for (int p : row) if (spent + p <= money) next[spent + p] = 1;
            }
            dp.swap(next);
        }
        int ans = -1;
        for (int spent = money; spent >= 0; --spent) if (dp[spent]) {
            ans = spent;
            break;
        }
        if (ans < 0) cout << "no solution\n";
        else cout << ans << '\n';
    }
    return 0;
}
