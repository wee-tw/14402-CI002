#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;
    for (int tc = 0; tc < T; ++tc) {
        int M;
        cin >> M;
        vector<pair<int, int>> seg;
        int l, r;
        while (cin >> l >> r && (l || r)) seg.push_back({l, r});
        sort(seg.begin(), seg.end());

        vector<pair<int, int>> chosen;
        int covered = 0, i = 0;
        bool ok = true;
        while (covered < M) {
            int best_r = covered;
            pair<int, int> best{};
            while (i < (int)seg.size() && seg[i].first <= covered) {
                if (seg[i].second > best_r) {
                    best_r = seg[i].second;
                    best = seg[i];
                }
                ++i;
            }
            if (best_r == covered) {
                ok = false;
                break;
            }
            chosen.push_back(best);
            covered = best_r;
        }

        if (tc) cout << '\n';
        if (!ok) cout << 0 << '\n';
        else {
            cout << chosen.size() << '\n';
            for (size_t i = 0; i < chosen.size(); ++i) {
                cout << chosen[i].first << ' ' << chosen[i].second << '\n';
            }
        }
    }
    return 0;
}
