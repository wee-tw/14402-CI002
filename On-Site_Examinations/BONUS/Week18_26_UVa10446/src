#include <bits/stdc++.h>
using namespace std;

long long memo[65][65];

long long trib(int n, int back) {
    if (n <= 1) return 1;
    long long &res = memo[n][back];
    if (res != -1) return res;
    res = 1;
    for (int i = 1; i <= back; ++i) res += trib(n - i, back);
    return res;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    memset(memo, -1, sizeof(memo));
    int n, back, tc = 1;
    while (cin >> n >> back && n <= 60) {
        cout << "Case " << tc++ << ": " << trib(n, back) << '\n';
    }
    return 0;
}
