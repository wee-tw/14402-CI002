#include <iostream>
#include <vector>
#include <cmath>
#include <algorithm>
#include <map>
#include <string>
#include <cstring>
#include <iomanip>
#include <sstream>
using namespace std;

int main() {

	int T;
	cin >> T;
	while (T--) {

		int M, N, Q;
		cin >> M >> N >> Q;

		cout << M << " " << N << " " << Q << endl;

		vector<string> matrix(M);
		for (int i = 0; i < M; i++) {
			cin >> matrix[i];
		}

		for (int i = 0; i < Q; i++) {

			int m, n;
			cin >> m >> n;

			char c = matrix[m][n];
			int r = 0;

			while (true) {
				int rr = r + 1;
				int m0 = m - rr;
				int m1 = m + rr;
				int n0 = n - rr;
				int n1 = n + rr;

				bool right = true;

				if (m0 < 0 || m1 >= M || n0 < 0 || n1 >= N) break;

				for (int i = m0; i <= m1; i++) {
					if (matrix[i][n0] != c || matrix[i][n1] != c) right = false;
				}

				for (int j = n0; j <= n1; j++) {
					if (matrix[m0][j] != c || matrix[m1][j] != c) right = false;
				}

				if (right) r += 1;
				else break;

			}

			cout << 2 * r + 1 << endl;
		}
	}
	return 0;
}