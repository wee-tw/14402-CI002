#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;
    while (T--) {
        int n, m, q;
        cin >> n >> m >> q;
        vector<string> g(n);
        for (string &row : g) cin >> row;
        cout << n << ' ' << m << ' ' << q << '\n';
        while (q--) {
            int r, c;
            cin >> r >> c;
            char target = g[r][c];
            int radius = 0;
            bool ok = true;
            while (ok) {
                int nr = radius + 1;
                if (r - nr < 0 || r + nr >= n || c - nr < 0 || c + nr >= m) break;
                for (int i = r - nr; i <= r + nr && ok; ++i)
                    for (int j = c - nr; j <= c + nr; ++j)
                        if (g[i][j] != target) {
                            ok = false;
                            break;
                        }
                if (ok) radius = nr;
            }
            cout << radius * 2 + 1 << '\n';
        }
    }
    return 0;
}
