#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    string s;
    int tc = 1;
    while (cin >> s && s != "end") {
        vector<char> top;
        for (char ch : s) {
            int best = -1;
            for (int i = 0; i < (int)top.size(); ++i) {
                if (top[i] >= ch && (best == -1 || top[i] < top[best])) best = i;
            }
            if (best == -1) top.push_back(ch);
            else top[best] = ch;
        }
        cout << "Case " << tc++ << ": " << top.size() << '\n';
    }
    return 0;
}
