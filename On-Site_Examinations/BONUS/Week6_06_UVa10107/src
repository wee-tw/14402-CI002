#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    vector<long long> a;
    long long x;
    while (cin >> x) {
        a.insert(lower_bound(a.begin(), a.end(), x), x);
        int n = a.size();
        if (n % 2) cout << a[n / 2] << '\n';
        else cout << (a[n / 2 - 1] + a[n / 2]) / 2 << '\n';
    }
    return 0;
}
