#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int p, c, tc = 1;
    while (cin >> p >> c && (p || c)) {
        list<int> q;
        int initial = min(p, c);
        for (int i = 1; i <= initial; ++i) q.push_back(i);
        cout << "Case " << tc++ << ":\n";
        while (c--) {
            char cmd;
            cin >> cmd;
            if (cmd == 'N') {
                int x = q.front();
                q.pop_front();
                q.push_back(x);
                cout << x << '\n';
            } else {
                int x;
                cin >> x;
                for (auto it = q.begin(); it != q.end(); ++it) {
                    if (*it == x) {
                        q.erase(it);
                        break;
                    }
                }
                q.push_front(x);
            }
        }
    }
    return 0;
}
