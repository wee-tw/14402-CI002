#include <iostream>
#include <deque>
#include <algorithm>
using namespace std;

int main() {
    long long P;
    int C;
    int tc = 1;

    while (cin >> P >> C) {
        if (P == 0 && C == 0) break;

        deque<long long> q;

        long long limit = min(P, (long long)C);

        for (long long i = 1; i <= limit; i++) {
            q.push_back(i);
        }

        cout << "Case " << tc++ << ":\n";

        for (int i = 0; i < C; i++) {
            char cmd;
            cin >> cmd;

            if (cmd == 'N') {
                long long person = q.front();
                q.pop_front();

                cout << person << "\n";

                q.push_back(person);
            } 
            else if (cmd == 'E') {
                long long x;
                cin >> x;

                q.erase(remove(q.begin(), q.end(), x), q.end());
                q.push_front(x);
            }
        }
    }

    return 0;
}