#include <bits/stdc++.h>
using namespace std;

double p, q, r, s, t, u;

double f(double x) {
    return p * exp(-x) + q * sin(x) + r * cos(x) + s * tan(x) + t * x * x + u;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    while (cin >> p >> q >> r >> s >> t >> u) {
        double left = f(0), right = f(1);
        if (left * right > 0) {
            cout << "No solution\n";
            continue;
        }
        double lo = 0, hi = 1;
        for (int i = 0; i < 100; ++i) {
            double mid = (lo + hi) / 2;
            if (f(lo) * f(mid) <= 0) hi = mid;
            else lo = mid;
        }
        cout << fixed << setprecision(4) << (lo + hi) / 2 << '\n';
    }
    return 0;
}
