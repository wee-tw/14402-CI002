#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    string s;
    while (getline(cin, s)) {
        list<char> text;
        auto it = text.end();
        for (char ch : s) {
            if (ch == '[') it = text.begin();
            else if (ch == ']') it = text.end();
            else {
                it = text.insert(it, ch);
                ++it;
            }
        }
        for (char ch : text) cout << ch;
        cout << '\n';
    }
    return 0;
}
