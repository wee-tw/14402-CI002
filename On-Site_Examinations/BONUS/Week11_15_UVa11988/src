#include <iostream>
#include <list>
#include <string>
using namespace std;

int main() {
    string s;

    while (getline(cin, s)) {
        list<string> parts;
        auto it = parts.end();

        string current = "";

        for (char c : s) {
            if (c == '[' || c == ']') {
                if (!current.empty()) {
                    parts.insert(it, current);
                    current.clear();
                }

                if (c == '[') {
                    it = parts.begin();
                } else {
                    it = parts.end();
                }
            } else {
                current += c;
            }
        }

        if (!current.empty()) {
            parts.insert(it, current);
        }

        for (string part : parts) {
            cout << part;
        }

        cout << "\n";
    }

    return 0;
}