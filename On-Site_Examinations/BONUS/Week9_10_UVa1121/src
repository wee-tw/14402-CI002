#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, s;
    while (cin >> n >> s) {
        vector<int> a(n);
        for (int &x : a) cin >> x;
        int best = n + 1, left = 0, sum = 0;
        for (int right = 0; right < n; ++right) {
            sum += a[right];
            while (sum >= s) {
                best = min(best, right - left + 1);
                sum -= a[left++];
            }
        }
        cout << (best == n + 1 ? 0 : best) << '\n';
    }
    return 0;
}
