#include <bits/stdc++.h>
using namespace std;

string source_word, target_word;
vector<string> ops;

void dfs(int in_pos, int out_pos, vector<char>& st) {
    if (out_pos == (int)target_word.size()) {
        for (int i = 0; i < (int)ops.size(); ++i) {
            if (i) cout << ' ';
            cout << ops[i];
        }
        cout << '\n';
        return;
    }
    if (in_pos < (int)source_word.size()) {
        st.push_back(source_word[in_pos]);
        ops.push_back("i");
        dfs(in_pos + 1, out_pos, st);
        ops.pop_back();
        st.pop_back();
    }
    if (!st.empty() && st.back() == target_word[out_pos]) {
        char ch = st.back();
        st.pop_back();
        ops.push_back("o");
        dfs(in_pos, out_pos + 1, st);
        ops.pop_back();
        st.push_back(ch);
    }
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    while (cin >> source_word >> target_word) {
        cout << "[\n";
        string a = source_word, b = target_word;
        sort(a.begin(), a.end());
        sort(b.begin(), b.end());
        if (a == b) {
            vector<char> st;
            dfs(0, 0, st);
        }
        cout << "]\n";
    }
    return 0;
}
