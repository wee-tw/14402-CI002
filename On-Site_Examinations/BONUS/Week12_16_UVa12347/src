#include <bits/stdc++.h>
using namespace std;

vector<int> preorder;

void postorder(int l, int r) {
    if (l >= r) return;
    int root = preorder[l];
    int split = l + 1;
    while (split < r && preorder[split] < root) ++split;
    postorder(l + 1, split);
    postorder(split, r);
    cout << root << '\n';
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int x;
    while (cin >> x) preorder.push_back(x);
    postorder(0, preorder.size());
    return 0;
}
