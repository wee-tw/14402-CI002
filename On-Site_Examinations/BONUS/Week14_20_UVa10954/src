#include <iostream>
#include <queue>
using namespace std;

int main() {
    int n;
    while (cin >> n && n) {
        priority_queue<long long, vector<long long>, greater<long long>> pq;
        for (int i = 0; i < n; i++) {
            long long x;
            cin >> x;
            pq.push(x);
        }

        long long cost = 0;
        while (pq.size() > 1) {
            long long a = pq.top(); 
            pq.pop();
            long long b = pq.top(); 
            pq.pop();
            long long sum = a + b;
            cost += sum;
            pq.push(sum);  //將temp cost也放pq
        }

        cout << cost << endl;
    }
    return 0;
}