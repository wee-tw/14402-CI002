#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    long long bin[3][3];
    vector<string> orders = {"BCG", "BGC", "CBG", "CGB", "GBC", "GCB"};
    map<char, int> idx{{'B', 0}, {'G', 1}, {'C', 2}};
    while (cin >> bin[0][0] >> bin[0][1] >> bin[0][2]
               >> bin[1][0] >> bin[1][1] >> bin[1][2]
               >> bin[2][0] >> bin[2][1] >> bin[2][2]) {
        long long total = 0;
        for (auto &row : bin) for (long long x : row) total += x;
        string best_order;
        long long best = LLONG_MAX;
        for (string order : orders) {
            long long keep = 0;
            for (int b = 0; b < 3; ++b) keep += bin[b][idx[order[b]]];
            long long moves = total - keep;
            if (moves < best) {
                best = moves;
                best_order = order;
            }
        }
        cout << best_order << ' ' << best << '\n';
    }
    return 0;
}
