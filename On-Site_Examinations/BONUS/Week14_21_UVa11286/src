#include <iostream>
#include <vector>
#include <map>
#include <algorithm>
using namespace std;

int main() {
    int n;

    while (cin >> n && n != 0) {
        map<vector<int>, int> freq;

        for (int i = 0; i < n; i++) {
            vector<int> course(5);

            for (int j = 0; j < 5; j++) {
                cin >> course[j];
            }

            sort(course.begin(), course.end());

            freq[course]++;
        }

        int maxCount = 0;

        for (auto p : freq) {
            maxCount = max(maxCount, p.second);
        }

        int ans = 0;

        for (auto p : freq) {
            if (p.second == maxCount) {
                ans += p.second;
            }
        }

        cout << ans << "\n";
    }

    return 0;
}