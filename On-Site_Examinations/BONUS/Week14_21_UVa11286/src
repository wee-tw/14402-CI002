#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    while (cin >> n && n) {
        map<array<int, 5>, int> cnt;
        int best = 0;
        for (int i = 0; i < n; ++i) {
            array<int, 5> courses;
            for (int &x : courses) cin >> x;
            sort(courses.begin(), courses.end());
            best = max(best, ++cnt[courses]);
        }
        int ans = 0;
        for (map<array<int, 5>, int>::iterator it = cnt.begin(); it != cnt.end(); ++it) {
            if (it->second == best) ans += it->second;
        }
        cout << ans << '\n';
    }
    return 0;
}
