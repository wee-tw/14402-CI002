#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int s, b;
    while (cin >> s >> b && (s || b)) {
        vector<int> left(s + 2), right(s + 2);
        for (int i = 1; i <= s; ++i) {
            left[i] = i - 1;
            right[i] = i + 1;
        }
        while (b--) {
            int l, r;
            cin >> l >> r;
            int nl = left[l], nr = right[r];
            if (nl < 1) cout << '*';
            else cout << nl;
            cout << ' ';
            if (nr > s) cout << '*';
            else cout << nr;
            cout << '\n';
            if (nl >= 1) right[nl] = nr;
            if (nr <= s) left[nr] = nl;
        }
        cout << "-\n";
    }
    return 0;
}
