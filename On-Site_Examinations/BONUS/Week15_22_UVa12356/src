#include <iostream>
#include <vector>
using namespace std;

int main() {

    int S, B;
    while (cin >> S >> B) {
        if (S == 0 && B == 0) break;

        vector<int> left(S + 2), right(S + 2);
        for (int i = 1; i <= S; i++) {
            left[i] = i - 1;
            right[i] = i + 1;
        }
        left[1] = -1;
        right[S] = -1;

        while (B--) {
            int L, R;
            cin >> L >> R;

            int l = left[L];
            int r = right[R];

            if (l == -1) cout << "* ";
            else cout << l << " ";
            if (r == -1) cout << "*\n";
            else cout << r << "\n";

            if (l != -1) right[l] = r;
            if (r != -1) left[r] = l;
        }
        cout << "-\n";
    }
    return 0;
}