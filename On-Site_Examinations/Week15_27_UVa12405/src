#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;
    for (int tc = 1; tc <= T; ++tc) {
        int n;
        string s;
        cin >> n >> s;
        int ans = 0;
        for (int i = 0; i < n;) {
            if (s[i] == '.') {
                ++ans;
                i += 3;
            } else {
                ++i;
            }
        }
        cout << "Case " << tc << ": " << ans << '\n';
    }
    return 0;
}
