#include <iostream>
#include <vector>
#include <string>
using namespace std;

int main() {

	int t;
	cin >> t;

	int c = 1;

	while (t--) {
		int n;
		cin >> n;
		string line;
		cin >> line;

		int count = 0;
		for (int i = 0; i < n; i++) {
			if (line[i] == '.') {
				count++;
				i += 2;
			}
		}
		cout << "Case " << c++ << ": ";
		cout << count << endl;
	}





	return 0;
}