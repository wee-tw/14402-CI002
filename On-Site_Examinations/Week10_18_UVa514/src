#include <iostream>
#include <stack>
#include <vector>
using namespace std;

int main() {
    int n;
    while (cin >> n && n != 0) {
        int first;
        while (cin >> first && first != 0) {
            vector<int> target(n);
            target[0] = first;
            for (int i = 1; i < n; i++) {
                cin >> target[i];
            }
            
            stack<int> station;
            int current = 1;
            bool possible = true;
            
            for (int i = 0; i < n; i++) {
                while (current <= n && (station.empty() || station.top() != target[i])) {
                    station.push(current);
                    current++;
                }
                if (station.top() == target[i]) {
                    station.pop();
                } else {
                    possible = false;
                    break;
                }
            }
            
            cout << (possible ? "Yes" : "No") << endl;
        }
        cout << endl;
    }
    return 0;
}