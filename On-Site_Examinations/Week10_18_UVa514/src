#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    while (cin >> n && n) {
        while (true) {
            vector<int> target(n);
            cin >> target[0];
            if (target[0] == 0) break;
            for (int i = 1; i < n; ++i) cin >> target[i];

            stack<int> station;
            int next_in = 1, idx = 0;
            while (next_in <= n) {
                station.push(next_in++);
                while (!station.empty() && station.top() == target[idx]) {
                    station.pop();
                    ++idx;
                }
            }
            cout << (idx == n ? "Yes" : "No") << '\n';
        }
        cout << '\n';
    }
    return 0;
}
