#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    while (cin >> n && n) {
        queue<int> q;
        for (int i = 1; i <= n; ++i) q.push(i);
        vector<int> discarded;
        while (q.size() > 1) {
            discarded.push_back(q.front());
            q.pop();
            q.push(q.front());
            q.pop();
        }
        cout << "Discarded cards:";
        for (int i = 0; i < (int)discarded.size(); ++i) cout << (i ? ", " : " ") << discarded[i];
        cout << "\nRemaining card: " << q.front() << '\n';
    }
    return 0;
}
