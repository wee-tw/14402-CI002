#include <iostream>
#include <vector>
#include <string>
using namespace std;

int main() {
    int test = 1;

    int t;
    cin >> t;

    while (t--) {
        bool symmetric = true;

        char a, b;
        int n;
        cin >> a >> b >> n;

        vector<vector<long long>> matrix(n, vector<long long>(n, 0));

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                cin >> matrix[i][j];

                if (matrix[i][j] < 0) {
                    symmetric = false;
                }
            }
        }

        if (symmetric) {
            for (int i = 0; i < n; i++) {
                for (int j = 0; j < n; j++) {
                    if (matrix[i][j] != matrix[n - i - 1][n - j - 1]) {
                        symmetric = false;
                        break;
                    }
                }

                if (!symmetric) break;
            }
        }

        cout << "Test #" << test++ << ": ";

        if (symmetric) {
            cout << "Symmetric.\n";
        } else {
            cout << "Non-symmetric.\n";
        }
    }

    return 0;
}