#include <bits/stdc++.h>
using namespace std;

int cycle_length(long long n) {
    int len = 1;
    while (n != 1) {
        if (n % 2 == 0) n /= 2;
        else n = 3 * n + 1;
        ++len;
    }
    return len;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int a, b;
    while (cin >> a >> b) {
        int lo = min(a, b), hi = max(a, b);
        int best = 0;
        for (int i = lo; i <= hi; ++i) best = max(best, cycle_length(i));
        cout << a << ' ' << b << ' ' << best << '\n';
    }
    return 0;
}
