#include <iostream>
using namespace std;

int length(int n) {
	int count = 1;

	while (n != 1) {
		if (n % 2 == 0) n = n / 2;
		else n = 3 * n + 1;
		count++;
	}
	return count;
}


int main() {
	int a, b;
	while (cin >> a >> b) {
		int start = min(a, b);
		int end = max(a, b);

		int max = 0;
		for (int i = start; i <= end; i++) {
			int cur = length(i);
			if (cur > max) {
				max = cur;
			}
		}

		cout << a << " " << b << " " << max << endl;
	}
	return 0;
}