#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;
    string s;
    getline(cin, s);
    while (T--) {
        getline(cin, s);
        stack<char> st;
        bool ok = true;
        for (char ch : s) {
            if (ch == '(' || ch == '[') st.push(ch);
            else if (ch == ')' || ch == ']') {
                if (st.empty() || (ch == ')' && st.top() != '(') || (ch == ']' && st.top() != '[')) {
                    ok = false;
                    break;
                }
                st.pop();
            }
        }
        cout << (ok && st.empty() ? "Yes" : "No") << '\n';
    }
    return 0;
}
