#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int teams, tc = 1;
    while (cin >> teams && teams) {
        unordered_map<int, int> belong;
        for (int i = 0; i < teams; ++i) {
            int cnt;
            cin >> cnt;
            while (cnt--) {
                int x;
                cin >> x;
                belong[x] = i;
            }
        }

        cout << "Scenario #" << tc++ << '\n';
        vector<queue<int>> member_queue(teams);
        queue<int> team_queue;
        vector<bool> in_queue(teams, false);
        string cmd;
        while (cin >> cmd && cmd != "STOP") {
            if (cmd == "ENQUEUE") {
                int x;
                cin >> x;
                int t = belong[x];
                if (!in_queue[t]) {
                    team_queue.push(t);
                    in_queue[t] = true;
                }
                member_queue[t].push(x);
            } else {
                int t = team_queue.front();
                cout << member_queue[t].front() << '\n';
                member_queue[t].pop();
                if (member_queue[t].empty()) {
                    team_queue.pop();
                    in_queue[t] = false;
                }
            }
        }
        cout << '\n';
    }
    return 0;
}
