#include <iostream>
#include <climits>
using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        int minPos = INT_MAX, maxPos = INT_MIN;
        
        for (int i = 0; i < n; i++) {
            int x;
            cin >> x;
            if (x < minPos) minPos = x;
            if (x > maxPos) maxPos = x;
        }
        
        cout << (maxPos - minPos) * 2 << endl;  //只需知道max、min商店位置
    }
    return 0;
}