#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;
    while (T--) {
        int n, pos = 0;
        cin >> n;
        vector<int> move(n + 1);
        string cmd;
        for (int i = 1; i <= n; ++i) {
            cin >> cmd;
            if (cmd == "LEFT") move[i] = -1;
            else if (cmd == "RIGHT") move[i] = 1;
            else {
                string as_word;
                int idx;
                cin >> as_word >> idx;
                move[i] = move[idx];
            }
            pos += move[i];
        }
        cout << pos << '\n';
    }
    return 0;
}
