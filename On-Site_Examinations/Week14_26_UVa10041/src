#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;
    while (T--) {
        int n;
        cin >> n;
        vector<int> a(n);
        for (int &x : a) cin >> x;
        sort(a.begin(), a.end());
        int med = a[n / 2], ans = 0;
        for (int x : a) ans += abs(x - med);
        cout << ans << '\n';
    }
    return 0;
}
