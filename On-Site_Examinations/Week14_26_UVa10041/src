#include <iostream>
#include <string>
#include <vector>
#include <algorithm>
using namespace std;

int main() {

	int t;
	cin >> t;
	while (t--) {

		int n;
		cin >> n;
		vector<int> v(n);
		for (int i = 0; i < n; i++) cin >> v[i];

		sort(v.begin(), v.end());

		int mid = v[n / 2];

		int count = 0;

		for (int i = 0; i < n; i++) {
			count += abs(mid - v[i]);
		}

		cout << count << endl;


	}


	return 0;
}