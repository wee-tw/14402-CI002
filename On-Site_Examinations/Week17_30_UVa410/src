#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int C, S, tc = 1;
    while (cin >> C >> S) {
        vector<int> mass(2 * C, 0);
        int total = 0;
        for (int i = 0; i < S; ++i) {
            cin >> mass[i];
            total += mass[i];
        }
        sort(mass.begin(), mass.end());
        double avg = (double)total / C;
        double imbalance = 0.0;

        cout << "Set #" << tc++ << '\n';
        for (int i = 0; i < C; ++i) {
            int a = mass[i], b = mass[2 * C - 1 - i];
            cout << ' ' << i << ':';
            if (a) cout << ' ' << a;
            if (b) cout << ' ' << b;
            cout << '\n';
            imbalance += fabs(a + b - avg);
        }
        cout << fixed << setprecision(5) << "IMBALANCE = " << imbalance << "\n\n";
    }
    return 0;
}
