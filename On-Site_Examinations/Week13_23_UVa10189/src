#include <iostream>
#include <vector>
#include <string>
using namespace std;

int main() {

	bool first = true;
	int test = 1;
	int m, n;
	while (cin >> m >> n) {
		if (m == 0 && n == 0) break;

		if (!first) cout << endl;
		first = false;
		cout << "Field #" << test++ << ":" << endl;

		int dx[8] = { 1, 1, 1, 0, -1, -1, -1, 0 };
		int dy[8] = { 1, 0, -1, -1, -1, 0, 1, 1 };

		vector<string> matrix(m);
		for (int i = 0; i < m; i++) cin >> matrix[i];

		for (int i = 0; i < m; i++) {
			for (int j = 0; j < n; j++) {
				char c = matrix[i][j];

				if (c == '*') cout << "*";
				else {
					int count = 0;
					for (int k = 0; k < 8; k++) {
						int x = i + dx[k], y = j + dy[k];
						if (x >= 0 && x < m && y >= 0 && y < n) {
							if (matrix[x][y] == '*') count++;
						}
					}

					cout << count;
				}

			}
			cout << endl;
        }
	}
	return 0;
}