#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m, field = 1;
    while (cin >> n >> m && (n || m)) {
        vector<string> g(n);
        for (string &row : g) cin >> row;
        if (field > 1) cout << '\n';
        cout << "Field #" << field++ << ":\n";
        for (int r = 0; r < n; ++r) {
            for (int c = 0; c < m; ++c) {
                if (g[r][c] == '*') {
                    cout << '*';
                    continue;
                }
                int cnt = 0;
                for (int dr = -1; dr <= 1; ++dr)
                    for (int dc = -1; dc <= 1; ++dc) {
                        int nr = r + dr, nc = c + dc;
                        if (nr >= 0 && nr < n && nc >= 0 && nc < m && g[nr][nc] == '*') ++cnt;
                    }
                cout << cnt;
            }
            cout << '\n';
        }
    }
    return 0;
}
