#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, q, tc = 1;
    while (cin >> n >> q && (n || q)) {
        vector<int> a(n);
        for (int &x : a) cin >> x;
        sort(a.begin(), a.end());
        cout << "CASE# " << tc++ << ":\n";
        while (q--) {
            int x;
            cin >> x;
            auto it = lower_bound(a.begin(), a.end(), x);
            if (it != a.end() && *it == x) cout << x << " found at " << (it - a.begin() + 1) << '\n';
            else cout << x << " not found\n";
        }
    }
    return 0;
}
