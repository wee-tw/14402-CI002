#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    string a, b;
    while (getline(cin, a) && getline(cin, b)) {
        vector<int> ca(256), cb(256);
        for (unsigned char ch : a) ca[ch]++;
        for (unsigned char ch : b) cb[ch]++;
        for (int ch = 0; ch < 256; ++ch) {
            int times = min(ca[ch], cb[ch]);
            while (times--) cout << char(ch);
        }
        cout << '\n';
    }
    return 0;
}
