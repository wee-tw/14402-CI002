#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;
    while (T--) {
        int d, i;
        cin >> d >> i;
        int node = 1;
        for (int level = 1; level < d; ++level) {
            if (i % 2) {
                node *= 2;
                i = (i + 1) / 2;
            } else {
                node = node * 2 + 1;
                i /= 2;
            }
        }
        cout << node << '\n';
    }
    return 0;
}
