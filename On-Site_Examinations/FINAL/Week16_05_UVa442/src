#include <bits/stdc++.h>
using namespace std;

struct Matrix {
    int r, c;
    bool marker;
};

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    cin >> n;
    map<char, Matrix> dim;
    for (int i = 0; i < n; ++i) {
        char name;
        int r, c;
        cin >> name >> r >> c;
        dim[name] = {r, c, false};
    }
    string expr;
    while (cin >> expr) {
        vector<Matrix> st;
        long long cost = 0;
        bool ok = true;
        for (char ch : expr) {
            if (ch == '(') st.push_back({0, 0, true});
            else if (isupper((unsigned char)ch)) st.push_back(dim[ch]);
            else if (ch == ')') {
                Matrix b = st.back(); st.pop_back();
                Matrix a = st.back(); st.pop_back();
                st.pop_back();
                if (a.c != b.r) {
                    ok = false;
                    break;
                }
                cost += 1LL * a.r * a.c * b.c;
                st.push_back({a.r, b.c, false});
            }
        }
        if (ok) cout << cost << '\n';
        else cout << "error\n";
    }
    return 0;
}
