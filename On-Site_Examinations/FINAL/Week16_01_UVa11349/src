#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;
    for (int tc = 1; tc <= T; ++tc) {
        char ch;
        string eq;
        int n;
        cin >> ch >> eq >> n;
        vector<long long> a(n * n);
        for (long long &x : a) cin >> x;
        bool ok = true;
        for (long long x : a) if (x < 0) ok = false;
        for (int i = 0; i < n * n; ++i) if (a[i] != a[n * n - 1 - i]) ok = false;
        cout << "Test #" << tc << ": " << (ok ? "Symmetric." : "Non-symmetric.") << '\n';
    }
    return 0;
}
