#include <bits/stdc++.h>
using namespace std;

vector<int> answer;

bool build(int lo, int hi, int height) {
    if (lo > hi) return true;
    if (height == 0) return false;
    int n = hi - lo + 1;
    int max_left = (1 << (height - 1)) - 1;
    int right_count = min(n - 1, max_left);
    int root = hi - right_count;
    answer.push_back(root);
    return build(lo, root - 1, height - 1) && build(root + 1, hi, height - 1);
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, h, tc = 1;
    while (cin >> n >> h && (n || h)) {
        answer.clear();
        cout << "Case " << tc++ << ":";
        if (h >= 31 || n <= (1 << h) - 1) {
            if (build(1, n, h)) {
                for (int x : answer) cout << ' ' << x;
                cout << '\n';
            } else {
                cout << " Impossible.\n";
            }
        } else {
            cout << " Impossible.\n";
        }
    }
    return 0;
}
