#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    map<string, string> lang{
        {"HELLO", "ENGLISH"},
        {"HOLA", "SPANISH"},
        {"HALLO", "GERMAN"},
        {"BONJOUR", "FRENCH"},
        {"CIAO", "ITALIAN"},
        {"ZDRAVSTVUJTE", "RUSSIAN"}
    };
    string word;
    int tc = 1;
    while (cin >> word && word != "#") {
        cout << "Case " << tc++ << ": " << (lang.count(word) ? lang[word] : "UNKNOWN") << '\n';
    }
    return 0;
}
