#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;
    while (T--) {
        int n, m;
        cin >> n >> m;
        unordered_map<int, int> cnt;
        for (int i = 0; i < n; ++i) {
            int x;
            cin >> x;
            cnt[x]++;
        }
        for (int i = 0; i < m; ++i) {
            int x;
            cin >> x;
            cnt[x]--;
        }
        long long ans = 0;
        for (unordered_map<int, int>::iterator it = cnt.begin(); it != cnt.end(); ++it) {
            ans += abs(it->second);
        }
        cout << ans << '\n';
    }
    return 0;
}
