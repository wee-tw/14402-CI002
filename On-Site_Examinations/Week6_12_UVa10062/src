#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    string line;
    bool first = true;
    while (getline(cin, line)) {
        if (!first) cout << '\n';
        first = false;
        vector<int> cnt(256);
        for (unsigned char ch : line) cnt[ch]++;
        vector<pair<int, int>> rows;
        for (int ascii = 0; ascii < 256; ++ascii) if (cnt[ascii]) rows.push_back({cnt[ascii], ascii});
        sort(rows.begin(), rows.end(), [](auto a, auto b) {
            if (a.first != b.first) return a.first < b.first;
            return a.second > b.second;
        });
        for (size_t i = 0; i < rows.size(); ++i) {
            cout << rows[i].second << ' ' << rows[i].first << '\n';
        }
    }
    return 0;
}
