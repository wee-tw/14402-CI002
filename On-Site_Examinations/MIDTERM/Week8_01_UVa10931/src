#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    unsigned int n;
    while (cin >> n && n) {
        string bits;
        int ones = 0;
        for (unsigned int x = n; x; x >>= 1) {
            bits.push_back((x & 1) ? '1' : '0');
            ones += x & 1;
        }
        reverse(bits.begin(), bits.end());
        cout << "The parity of " << bits << " is " << ones << " (mod 2).\n";
    }
    return 0;
}
