#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int a, b;
    while (cin >> a >> b && (a || b)) {
        int lo = ceil(sqrt(a));
        int hi = floor(sqrt(b));
        cout << max(0, hi - lo + 1) << '\n';
    }
    return 0;
}
