#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    while (cin >> n >> m && (n || m)) {
        vector<int> head(n), knight(m);
        for (int &x : head) cin >> x;
        for (int &x : knight) cin >> x;
        sort(head.begin(), head.end());
        sort(knight.begin(), knight.end());
        long long cost = 0;
        int j = 0;
        bool ok = true;
        for (int h : head) {
            while (j < m && knight[j] < h) ++j;
            if (j == m) {
                ok = false;
                break;
            }
            cost += knight[j++];
        }
        if (ok) cout << cost << '\n';
        else cout << "Loowater is doomed!\n";
    }
    return 0;
}
