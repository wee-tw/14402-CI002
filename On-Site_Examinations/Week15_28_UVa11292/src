#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
	int D, W;
	while (cin >> D >> W) {
		if (D == 0 && W == 0) break;

		vector<int> drag(D), warrior(W);
		for (int i = 0; i < D; i++) cin >> drag[i];
		for (int i = 0; i < W; i++) cin >> warrior[i];

		sort(drag.begin(), drag.end());
		sort(warrior.begin(), warrior.end());

		int i = 0, j = 0, ans = 0;
		while (i < D && j < W) {
			if (warrior[j] >= drag[i]) {  //從最小warrior開始找對drag first-fit的士兵
				ans += warrior[j];
				i++;
				j++;
			}
			else {
				j++;
			}
		}

		if (i == D) cout << ans << endl;  //代表找到足夠多士兵
		else cout << "Loowater is doomed!" << endl;
	}
	return 0;
}