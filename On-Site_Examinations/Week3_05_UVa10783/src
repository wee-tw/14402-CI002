#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;
    for (int tc = 1; tc <= T; ++tc) {
        int a, b;
        cin >> a >> b;
        int sum = 0;
        for (int x = a; x <= b; ++x) if (x % 2) sum += x;
        cout << "Case " << tc << ": " << sum << '\n';
    }
    return 0;
}
