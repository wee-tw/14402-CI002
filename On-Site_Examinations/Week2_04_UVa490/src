#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    vector<string> lines;
    string s;
    size_t width = 0;
    while (getline(cin, s)) {
        lines.push_back(s);
        width = max(width, s.size());
    }

    for (size_t c = 0; c < width; ++c) {
        for (int r = (int)lines.size() - 1; r >= 0; --r) {
            cout << (c < lines[r].size() ? lines[r][c] : ' ');
        }
        cout << '\n';
    }
    return 0;
}
